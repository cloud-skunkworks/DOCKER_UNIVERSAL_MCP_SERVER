# Non-secret configuration. Local is usable without cloud credentials.
RAG_PROVIDER=local
RAG_LOCAL_PATH=data/corpus.json
# Cloud mode reads one UTF-8 JSON object, in the same format as data/corpus.json.
# RAG_PROVIDER=aws|azure|gcp
# RAG_OBJECT=approved/corpus.json
# AWS_REGION=
# RAG_BUCKET=
# AZURE_STORAGE_ACCOUNT_URL=
# AZURE_STORAGE_CONTAINER=
# GCP_PROJECT_ID=
# Optional approved collector endpoint, e.g. an internal HTTPS OTLP /v1/traces URL.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
